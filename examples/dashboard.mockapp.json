                    "children": [
                      { "id": "cmp-card-revenue", "type": "content.card", "name": "Revenue Card", "props": { "title": "Revenue", "text": "$128,400 this month", "shadow": "regular" }, "meta": { "locked": false, "hidden": false }, "children": [] },
                      { "id": "cmp-badge-growth", "type": "content.badge", "name": "Badge", "props": { "text": "+12%", "variant": "success", "pill": true }, "meta": { "locked": false, "hidden": false }, "children": [] }
                    ]
                  },
                  {
                    "id": "cmp-col-right-dashboard",
                    "type": "layout.column",
                    "name": "Data",
                    "props": { "gap": "3", "widths": { "xs": "12", "sm": "12", "md": "8", "lg": "8", "xl": "9", "xxl": "9" } },
                    "meta": { "locked": false, "hidden": false },
                    "children": [
                      { "id": "cmp-table-dashboard", "type": "data.table", "name": "Users Table", "props": { "columnsText": "Name, Role, Status", "rowsText": "Avery, Admin, Active\nRiley, Editor, Pending\nJordan, Viewer, Disabled", "striped": true, "hover": true }, "meta": { "locked": false, "hidden": false }, "children": [] }
                    ]
                  }
                ]
              }
            ]
          }
