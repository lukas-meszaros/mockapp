            "meta": { "locked": false, "hidden": false },
            "children": []
          },
          {
            "id": "cmp-container-dashboard",
            "type": "layout.container",
            "name": "Container",
            "props": { "fluid": false, "padding": "3", "gap": "3" },
            "meta": { "locked": false, "hidden": false },
            "children": [
              {
                "id": "cmp-row-dashboard",
                "type": "layout.row",
